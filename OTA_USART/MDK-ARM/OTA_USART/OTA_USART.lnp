"ota_usart\startup_stm32f103xe.o"
"ota_usart\main.o"
"ota_usart\gpio.o"
"ota_usart\spi.o"
"ota_usart\usart.o"
"ota_usart\stm32f1xx_it.o"
"ota_usart\stm32f1xx_hal_msp.o"
"ota_usart\stm32f1xx_hal_gpio_ex.o"
"ota_usart\stm32f1xx_hal_spi.o"
"ota_usart\stm32f1xx_hal.o"
"ota_usart\stm32f1xx_hal_rcc.o"
"ota_usart\stm32f1xx_hal_rcc_ex.o"
"ota_usart\stm32f1xx_hal_gpio.o"
"ota_usart\stm32f1xx_hal_dma.o"
"ota_usart\stm32f1xx_hal_cortex.o"
"ota_usart\stm32f1xx_hal_pwr.o"
"ota_usart\stm32f1xx_hal_flash.o"
