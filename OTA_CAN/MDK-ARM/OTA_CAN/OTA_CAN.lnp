"ota_can\stm32f1xx_hal.o"
"ota_can\stm32f1xx_hal_rcc.o"
"ota_can\stm32f1xx_hal_rcc_ex.o"
"ota_can\stm32f1xx_hal_gpio.o"
"ota_can\stm32f1xx_hal_dma.o"
"ota_can\stm32f1xx_hal_cortex.o"
"ota_can\stm32f1xx_hal_pwr.o"
