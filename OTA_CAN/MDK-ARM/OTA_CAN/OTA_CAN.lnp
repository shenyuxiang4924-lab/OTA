--cpu Cortex-M3
"ota_can\startup_stm32f103xe.o"
"ota_can\main.o"
"ota_can\gpio.o"
"ota_can\can.o"
"ota_can\spi.o"
"ota_can\stm32f1xx_it.o"
"ota_can\stm32f1xx_hal_msp.o"
"ota_can\stm32f1xx_hal_gpio_ex.o"
